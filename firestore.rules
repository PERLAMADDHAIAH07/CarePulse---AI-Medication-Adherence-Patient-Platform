rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Patient profile document rules
    match /patients/{patientId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == patientId ||
        exists(/databases/$(database)/documents/familyConnections/$(request.auth.uid + '_' + patientId)) ||
        exists(/databases/$(database)/documents/familyConnections/$(patientId + '_' + request.auth.uid))
      );
      allow write: if isOwner(patientId);
    }

    // Medications collection
    match /medications/{medicationId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        request.auth.uid == resource.data.patientId
      );
      allow write: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        (resource != null && resource.data.patientId == request.auth.uid)
      );
    }

    // Adherence Logs collection
    match /adherenceLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        request.auth.uid == resource.data.patientId
      );
      allow write: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        (resource != null && resource.data.patientId == request.auth.uid)
      );
    }

    // Symptoms collection
    match /symptoms/{symptomId} {
      allow read, write: if isAuthenticated() && (
        (resource != null && resource.data.patientId == request.auth.uid) ||
        (request.resource != null && request.resource.data.patientId == request.auth.uid)
      );
    }

    // Family Connections collection
    match /familyConnections/{connectionId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverId == request.auth.uid
      );
      allow write: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        (resource != null && resource.data.patientId == request.auth.uid)
      );
    }

    // Invitations collection
    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        (resource != null && resource.data.createdBy == request.auth.uid)
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        (request.resource != null && request.resource.data.targetUserId == request.auth.uid)
      );
    }

    // Login History collection
    match /loginHistory/{eventId} {
      allow read, write: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // Active Devices collection
    match /activeDevices/{deviceId} {
      allow read, write: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // Security Events collection
    match /securityEvents/{eventId} {
      allow read, write: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }
  }
}
